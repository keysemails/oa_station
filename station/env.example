# =============================================================================
# OA-Station Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment.

# =============================================================================
# REQUIRED: Management Key
# =============================================================================
# OpenRouter management key used to issue ephemeral API keys.
# Get yours at: https://openrouter.ai/docs/guides/overview/auth/management-api-keys
# OPENROUTER_MANAGEMENT_KEY=sk-or-v1-your-management-key-here

# =============================================================================
# REQUIRED: Station Identity
# =============================================================================
# Human-readable station id used in response signatures.
STATION_STATION_ID=station-self-hosted

# Optional identity file path (Ed25519 keypair persisted here)
# STATION_IDENTITY_FILE=identity.json

# Encryption key for identity private key at rest (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STATION_ENCRYPTION_KEY=

# =============================================================================
# REQUIRED FOR TICKET ISSUANCE + REDEMPTION
# =============================================================================
# Inference ticket issuer public key
# STATION_TOKEN_PUBLIC_KEY=

# Inference ticket issuer private key (required for /tickets/issue)
# STATION_TOKEN_PRIVATE_KEY=

# If only STATION_TOKEN_PUBLIC_KEY is set, station runs in redemption-only mode.
# If neither is set, ticket keys are auto-generated on first startup.

# =============================================================================
# SECURITY (Recommended for Production)
# =============================================================================
# Restrict /request_key access by source IP (comma-separated)
# STATION_REQUEST_KEY_ALLOWED_IPS=127.0.0.1

# Trusted proxy IPs for X-Forwarded-For parsing
# STATION_TRUSTED_PROXIES=127.0.0.1

# CORS allowed origins (comma-separated, defaults to * if not set)
# CORS_ORIGINS=http://localhost:3000

# =============================================================================
# SERVER SETTINGS
# =============================================================================
STATION_HOST=0.0.0.0
STATION_PORT=18888
STATION_LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================
STORAGE_TYPE=sqlite
DATABASE_FILE=station.db

# SQLite tuning (optional)
# STATION_DB_TIMEOUT=10
# STATION_DB_BUSY_TIMEOUT_MS=5000

# =============================================================================
# CONFIG UI
# =============================================================================
# Enable the web-based configuration UI (localhost-only).
# STATION_ENABLE_CONFIG_UI=true

# =============================================================================
# DEVELOPMENT
# =============================================================================
# STATION_RELOAD=true
